<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PropnexPoster.WPF"
        xmlns:hc="https://handyorg.github.io/handycontrol" 
        x:Class="PropnexPoster.WPF.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Canvas Grid.Row="0">
                <Button Width="100" hc:IconElement.Geometry="{StaticResource SaveGeometry }" Canvas.Top="5" Canvas.Left="10">开始</Button>
                <Button Width="100" hc:IconElement.Geometry="{StaticResource CloseGeometry}" Canvas.Top="5" Canvas.Right="10">停止</Button>
            </Canvas>
            <TextBox  Grid.Row="1" Style="{StaticResource TextBoxExtend}"
                         hc:TitleElement.TitleWidth="70" 
                         hc:InfoElement.TitlePlacement="Left" 
                         hc:InfoElement.Title="Number:" 
                         Margin="0,5,0,5" Canvas.Left="10" Width="230"></TextBox>
            <GroupBox Grid.Row="2" Style="{StaticResource BaseStyle}" Header="Run Info:"></GroupBox>
        </Grid>
        <GroupBox Style="{StaticResource BaseStyle}" Grid.Column="1" Header="Log">
            <RichTextBox></RichTextBox>
        </GroupBox>
    </Grid>
</Window>
