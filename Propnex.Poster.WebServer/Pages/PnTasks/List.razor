@page "/PnTask/List"
@using Volo.Abp.Application.Dtos
@using Dtos
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@inherits AbpCrudPageBase<WebServer.Services.IPnTaskAppService, PnTaskDto , Guid, PnTaskListInput, CreateUpdatePnTaskDto>
@inject AuthenticationStateProvider AuthenticationStateProvider
<Card>
    <CardHeader>
        <PageHeader Title="TaskList"
                    BreadcrumbItems="@BreadcrumbItems"
                    Toolbar="@Toolbar">
        </PageHeader>
    </CardHeader>
    <CardBody>
        <Row Margin="Margin.Is2.FromBottom">
            <Column ColumnSize="ColumnSize.Is3">
                <TextEdit Placeholder="Search by number..." @bind-Text="@NumberFilter" @oninput="OnNumberFilterChanged" />
            </Column>
        </Row>
        <DataGrid TItem="PnTaskDto"
                  Data="Entities"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  PageSize="PageSize">
            <DataGridColumns>
                <DataGridColumn TItem="PnTaskDto" Field="@nameof(PnTaskDto.Number)" Caption="Number"/>
               
                <DataGridColumn TItem="PnTaskDto" Field="@nameof(PnTaskDto.RetryCount)" Caption="RetryCount" />
                <DataGridColumn TItem="PnTaskDto" Field="@nameof(PnTaskDto.LastModificationTime)" Caption="LastModificationTime">
                    <DisplayTemplate>
                        @context.LastModificationTime?.ToString()
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="PnTaskDto" Field="@nameof(PnTaskDto.CreationTime)" Caption="@L["CreationTime"]">
                    <DisplayTemplate>
                        @context.CreationTime.ToString()
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridEntityActionsColumn TItem="PnTaskDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="PnTaskDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="PnTaskDto"
                                          Text="重试"
                                          ConfirmationMessage='()=> GetConfirmationMessage("Are you sure you want to run it again?")'
                                          Clicked="async ()=>await RetryTask(context)" />
                            <EntityAction TItem="PnTaskDto"
                                          Text="日志"
                                          Clicked="async ()=>await ShowLogsAsync(context)" />
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>
<Modal @ref="LogModal" Size="ModalSize.ExtraLarge">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>日志 — @LogsTaskNumber</ModalTitle>
            <CloseButton Clicked="()=>LogModal.Close(CloseReason.UserClosing)" />
        </ModalHeader>
        <ModalBody>
            @if (LogsLoading)
            {
                <p>Loading...</p>
            }
            else if (TaskLogs == null || TaskLogs.Count == 0)
            {
                <p>No logs found.</p>
            }
            else
            {
                <Table Striped="true" Hoverable="true" Narrow="true" Responsive="true">
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>Time</TableHeaderCell>
                            <TableHeaderCell>Message</TableHeaderCell>
                            <TableHeaderCell>MachineId</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var log in TaskLogs)
                        {
                            <TableRow>
                                <TableRowCell>@log.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</TableRowCell>
                                <TableRowCell>@log.Message</TableRowCell>
                                <TableRowCell>@log.MachineId</TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </ModalBody>
    </ModalContent>
</Modal>
<Modal @ref="CreatePropertyTaskModal">
    <ModalContent Centered="true">
        <Form>
            <ModalHeader>
                <ModalTitle>CreatePropertyTask</ModalTitle>
                <CloseButton Clicked="()=>CreatePropertyTaskModal.Close(CloseReason.UserClosing)" />
            </ModalHeader>
            <ModalBody>
                <Validations Model="@CreatePropertyTaskDto" ValidateOnLoad="false">
                    <Field>
                        <FieldLabel>StartId:</FieldLabel>
                        <NumericEdit TValue="int" @bind-Value="@CreatePropertyTaskDto.MinId"></NumericEdit>
                    </Field>
                    <Field>
                        <FieldLabel>EndId:</FieldLabel>
                        <NumericEdit TValue="int" @bind-Value="@CreatePropertyTaskDto.MaxId"></NumericEdit>
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="()=>CreatePropertyTaskModal.Close(CloseReason.UserClosing)">@L["Cancel"]</Button>
                <SubmitButton Clicked="@CreatePropertyTaskAsync" />
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>
