<suki:SukiWindow x:Class="PropnexPoster.Avalonia.MainWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="https://github.com/kikipoulet/SukiUI"
                 Title="PropnexPoster"
                 Width="900" Height="520"
                 Icon="/Logo.ico">
    <Grid ColumnDefinitions="280,*" Margin="16">
        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="btnStart" Content="开始" Click="btnStart_Click" Classes="Flat Accent" IsEnabled="True" />
                <Button x:Name="btnStop" Content="停止" Click="btnStop_Click" IsEnabled="False" />
            </StackPanel>
            <TextBox Watermark="Number" />
            <suki:GroupBox Header="Run Info:">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding RunInfo.TaskNumber}" />
                    <TextBlock Text="{Binding RunInfo.StartTime}" />
                    <TextBlock Text="{Binding RunInfo.Account}" />
                    <TextBlock Text="{Binding RunInfo.AgentId}" />
                    <TextBlock Text="{Binding RunInfo.TaskType}" />
                    <TextBlock Text="{Binding RunInfo.ListingCount}" />
                    <TextBlock Text="{Binding RunInfo.TaskItemId}" />
                </StackPanel>
            </suki:GroupBox>
        </StackPanel>
        <suki:GroupBox Grid.Column="1" Header="Log">
            <TextBox x:Name="logBox" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas,Menlo,monospace" />
        </suki:GroupBox>
    </Grid>
</suki:SukiWindow>
