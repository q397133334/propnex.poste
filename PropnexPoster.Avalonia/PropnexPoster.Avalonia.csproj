<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ApplicationIcon>Logo.ico</ApplicationIcon>
		<NeutralLanguage>en</NeutralLanguage>
		<AssemblyVersion>1.0.1.85</AssemblyVersion>
		<FileVersion>1.0.1.85</FileVersion>
		<PlatformTarget>x64</PlatformTarget>
		<InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.Extensions.Configuration.Binder.SourceGeneration</InterceptorsNamespaces>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Logo.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="Avalonia.Diagnostics" Version="12.1.1" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="SukiUI" Version="7.0.1" />
		<PackageReference Include="Flurl.Http" Version="4.0.2" />
		<PackageReference Include="Polly" Version="8.6.6" />
		<PackageReference Include="RestSharp" Version="114.0.0" />
		<PackageReference Include="Serilog" Version="4.3.1" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="SlackBotMessages" Version="2.1.0" />
		<PackageReference Include="Volo.Abp" Version="10.3.0" />
		<PackageReference Include="Volo.Abp.Autofac" Version="10.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Propnex.Poster.Dtos\Propnex.Poster.Dtos\Propnex.Poster.Dtos.csproj" />
		<ProjectReference Include="..\Propnex.Poster.PropertyGuru.Mobile\Propnex.Poster.PropertyGuru.Mobile.csproj" />
		<ProjectReference Include="..\Propnex.Poster.PropertyGuru\Propnex.Poster.PropertyGuru.csproj" />
		<ProjectReference Include="..\Propnex.Poster.Share\Propnex.Poster.Share.csproj" />
		<ProjectReference Include="..\Propnex.Task\Propnex.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
